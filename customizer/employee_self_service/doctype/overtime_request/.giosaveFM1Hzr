import frappe
from frappe.model.document import Document
from frappe.utils import flt, today, add_days, nowdate, get_link_to_form
from frappe import _ as __

class OvertimeRequest(Document):

    def before_insert(self):
        if not self.working_days:
            self.working_days = 30  # Default value for working days

    def on_submit(self):
        overtime_request_on_submit(self)


@frappe.whitelist()
def pay_on_change(doc):
    """
    Handle changes to the 'pay_on' field.
    """
    if doc.get('pay_on') == "Leave Day":
        doc['rate_per_hour'] = 1
        calculate_per_day(doc)
    elif doc.get('pay_on') == "On Salary" and doc.get('employee'):
        salary_structure = frappe.get_value("Salary Structure", {'employee': doc.get('employee')}, 'custom_basic_salary')
        if salary_structure:
            doc['salary'] = salary_structure
            calculate_hourly_rate(doc)
        else:
            frappe.msgprint(__('Basic Salary is missing or zero for the selected employee.'))
            doc['salary'] = None
    else:
        doc['salary'] = None


def calculate_hourly_rate(doc):
    """
    Calculate hourly rate based on salary.
    """
    salary = flt(doc.get('salary'))
    working_days = flt(doc.get('working_days', 30))
    if salary > 0:
        hourly_rate = (salary / working_days / 8) * 1.5
        doc['hourly_rate'] = hourly_rate


def calculate_total_salary(doc):
    """
    Calculate total salary based on total working hours and hourly rate.
    """
    total_working_hours = flt(doc.get('total_working_hours', 0))
    hourly_rate = flt(doc.get('hourly_rate', 0))
    total_salary = total_working_hours * hourly_rate
    doc['total_salary'] = total_salary


def calculate_per_day(doc):
    """
    Calculate per day rate.
    """
    total_working_hours = flt(doc.get('total_working_hours', 0))
    rate_per_hour = flt(doc.get('rate_per_hour', 0))
    per_day = (total_working_hours / 8) * rate_per_hour
    doc['per_day'] = per_day


@frappe.whitelist()
def update_dates_based_on_pay_on(doc):
    """
    Update `from_date` and `to_date` based on `pay_on`.
    """
    pay_on = doc.get('pay_on')
    current_date = today()

    if pay_on == "On Salary":
        doc['from_date'] = current_date
        doc['to_date'] = current_date
    elif pay_on == "Leave Day":
        date_of_joining = doc.get('date_of_joining')
        employee_type = doc.get('employee_type')

        if date_of_joining and employee_type:
            from_date = add_days(date_of_joining, 0)
            if employee_type == "Labor":
                to_date = add_days(from_date, 2 * 365)
            elif employee_type == "Employee":
                to_date = add_days(from_date, 1 * 365)
            else:
                to_date = None
            doc['from_date'] = from_date
            doc['to_date'] = to_date
        else:
            frappe.msgprint(__('Date of Joining or Employee Type is missing.'))
            doc['from_date'] = None
            doc['to_date'] = None
    else:
        doc['from_date'] = None
        doc['to_date'] = None


def overtime_request_on_submit(doc):
    """Handle on-submit actions for Overtime Request."""
    if doc.get("pay_on") == "On Salary" and doc.get("total_salary") > 0:
        create_additional_salary(doc)
    elif doc.get("pay_on") == "Leave Day":
        create_leave_allocation(doc)


def create_additional_salary(doc):
    """Create an Additional Salary document."""
    additional_salary = frappe.get_doc({
        'doctype': 'Additional Salary',
        'employee': doc.employee,
        'amount': doc.total_salary,
        'payroll_date': doc.posting_date or nowdate(),
        'salary_component': 'Extra work(العمل الإضافي)',
        'overtime_request': doc.name
    })
    additional_salary.insert(ignore_permissions=True)

    additional_salary_link = get_link_to_form('Additional Salary', additional_salary.name)
    frappe.msgprint(__('Additional Salary created successfully: {0}').format(additional_salary_link))


def create_leave_allocation(doc):
    """Create a Leave Allocation document."""
    leave_allocation = frappe.get_doc({
        'doctype': 'Leave Allocation',
        'employee': doc.employee,
        'leave_type': 'Compensatory Off (تعويض اوفر تايم)',
        'from_date': doc.from_date,
        'to_date': doc.to_date,
        'posting_date': doc.posting_date,
        'new_leaves_allocated': doc.per_day,
        'carry_forward': 1,
        'description': doc.note
    })
    leave_allocation.insert(ignore_permissions=True)

    leave_allocation_link = get_link_to_form('Leave Allocation', leave_allocation.name)
    frappe.msgprint(__('Leave Allocation created successfully: {0}').format(leave_allocation_link))

