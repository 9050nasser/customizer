If the stock levels are correct and you are still encountering the NegativeStockError, there may be an underlying issue with the stock ledger entries or the transaction sequence. Here are a few steps to diagnose and potentially resolve this issue:

Steps to Diagnose and Resolve the Negative Stock Error
Check Stock Ledger Entries:

Verify the stock ledger entries for the item and warehouse to ensure they are consistent and accurate.
Rebuild the Serial and Batch Bundle:

Sometimes, rebuilding the serial and batch bundle for all stock entries can resolve inconsistencies.
Repost Stock Ledger Entries:

Reposting stock ledger entries can correct any discrepancies in the stock balance.
Script to Rebuild Serial and Batch Bundle for All Stock Entries
Here is a script to help you rebuild the serial and batch bundle for all stock entries:

python
Copy code
import frappe

def rebuild_serial_and_batch_bundle():
    # Fetch all stock entries that involve serial or batch items
    stock_entries = frappe.db.get_all('Stock Entry', filters={'docstatus': 1}, fields=['name'])
    
    for entry in stock_entries:
        stock_entry = frappe.get_doc('Stock Entry', entry['name'])
        
        # Loop through all items in the stock entry
        for item in stock_entry.items:
            if item.serial_no or item.batch_no:
                try:
                    # Rebuild serial and batch bundle
                    frappe.get_doc({
                        'doctype': 'Serial No',
                        'item_code': item.item_code,
                        'serial_no': item.serial_no
                    }).save(ignore_permissions=True)
                    
                    frappe.get_doc({
                        'doctype': 'Batch',
                        'item_code': item.item_code,
                        'batch_no': item.batch_no
                    }).save(ignore_permissions=True)
                    
                    print(f"Rebuilt serial and batch bundle for item {item.item_code} in stock entry {stock_entry.name}.")
                except Exception as e:
                    print(f"Failed to rebuild serial and batch bundle for item {item.item_code} in stock entry {stock_entry.name}: {str(e)}")

if __name__ == "__main__":
    rebuild_serial_and_batch_bundle()
Script to Repost Stock Ledger Entries
Here is a script to repost stock ledger entries:

python
Copy code
import frappe
from erpnext.stock.stock_ledger import repost_stock

def repost_all_stock_entries():
    # Fetch all stock ledger entries
    stock_ledger_entries = frappe.db.get_all('Stock Ledger Entry', filters={}, fields=['name', 'item_code', 'warehouse'])
    
    for sle in stock_ledger_entries:
        try:
            repost_stock(item_code=sle['item_code'], warehouse=sle['warehouse'])
            print(f"Reposted stock ledger entry for item {sle['item_code']} in warehouse {sle['warehouse']}.")
        except Exception as e:
            print(f"Failed to repost stock ledger entry for item {sle['item_code']} in warehouse {sle['warehouse']}: {str(e)}")

if __name__ == "__main__":
    repost_all_stock_entries()
