Copy code
import frappe
import logging
from erpnext.stock.doctype.item.item import Item

# Set up logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

def recalculate_bin_for_all_active_items():
    logger.info("Starting the recalculation of bin quantities for all active items.")
    
    # Fetch all active items
    items = frappe.get_all('Item', filters={'disabled': 0}, fields=['name'])
    
    for item in items:
        item_code = item.name
        logger.info(f"Processing Item: {item_code}")
        
        try:
            # Fetch the Item document
            item_doc = frappe.get_doc('Item', item_code)
            
            # Call the recalculate_bin_qty method
            item_doc.recalculate_bin_qty(new_name=item_code)
            
            logger.info(f"Successfully recalculated bin quantities for Item: {item_code}")
        except Exception as e:
            logger.error(f"Error recalculating bin quantities for Item: {item_code} - {e}")

    logger.info("Completed the recalculation of bin quantities for all active items.")
