import frappe
from erpnext.stock.doctype.item.item import Item

def recalculate_bin_for_all_active_items():
    # Fetch all active items
    items = frappe.get_all('Item', filters={'disabled': 0}, fields=['name'])
    
    for item in items:
        item_code = item.name
        
        # Fetch the Item document
        item_doc = frappe.get_doc('Item', item_code)
        
        # Call the recalculate_bin_qty method
        item_doc.recalculate_bin_qty(new_name=item_code)
        
        print(f"Recalculated bin quantities for Item: {item_code}")

# Run the recalculation
recalculate_bin_for_all_active_items()
Explanation
Fetching Active Items: The script fetches all active items that are not disabled.
Iterating Over Items: For each active item, it fetches the corresponding Item document.
Calling recalculate_bin_qty: It calls the recalculate_bin_qty method on the Item document.
Logging: It prints a message for each item after recalculating the bin quantities.
